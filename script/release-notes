#!/usr/bin/env bash
# Prints the CHANGELOG section for a version, without its "## VERSION (date)"
# heading, for use as release notes. Fails if the section is missing or
# empty, so a version bump without its CHANGELOG entry can't be released:
#
#   script/release-notes 0.2.0
set -euo pipefail

version="${1:?usage: script/release-notes VERSION}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

notes="$(awk -v heading="## $version " '
  index($0, heading) == 1 { found = 1; next }
  found && /^## / { exit }
  found { print }
' "$root/CHANGELOG.md" | sed '/./,$!d')"

if [ -z "$notes" ]; then
  echo "CHANGELOG.md has no notes under \"## $version (...)\"" >&2
  exit 1
fi
printf '%s\n' "$notes"
